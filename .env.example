# Docker image registry prefix (optional; leave empty for local builds)
DOCKER_REGISTRY=

# API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=oboxsteam.database;Port=5432;Database=OboxSteam_db;Username=postgres;Password=postgres
JWT__SecretKey=your-jwt-secret-at-least-32-chars
JWT__Issuer=OboxSteam
JWT__Audience=OboxSteamUsers
RESEND_APITOKEN=re_your_resend_api_key
RESEND_FROM=noreply@contact.oboxsteam.website
APP_BASE_URL=https://oboxsteam.website
API_PORT=5000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=OboxSteam_db
POSTGRES_PORT=5433
