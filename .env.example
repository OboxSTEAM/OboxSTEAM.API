# ============================================
# OboxSteam API - Environment Variables Template
# ============================================
# Copy this file to .env and update the values
# ============================================

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=OboxSteam_db
POSTGRES_PORT=5433
CONNECTION_STRING=Host=oboxsteam.database;Port=5432;Database=OboxSteam_db;Username=postgres;Password=your_postgres_password

# --- Redis ---
REDIS_CONNECTION=oboxsteam-redis:6379,abortConnect=false

# --- JWT ---
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters
JWT_ISSUER=OboxSteam
JWT_AUDIENCE=OboxSteamUsers

# --- Resend (Email) ---
RESEND_APITOKEN=re_your_resend_api_token
RESEND_FROM=noreply@yourdomain.com

# --- AWS S3 (Object Storage) ---
AWS_S3_BUCKET=oboxsteam-bucket

# --- AWS Rekognition ---
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1

# --- CORS (Production only) ---
CORS_ALLOWED_ORIGIN=https://yourdomain.com

# --- App ---
APP_BASE_URL=https://yourdomain.com
