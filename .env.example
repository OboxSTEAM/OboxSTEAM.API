# Copy to .env and fill in real values. Never commit .env.

# Docker image (optional; local compose builds from Dockerfile when image is not pulled)
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

# API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=oboxsteam.database;Port=5432;Database=OboxSteam_db;Username=postgres;Password=postgres
JWT__SecretKey=change-me-min-16-chars
JWT__Issuer=OboxSteam
JWT__Audience=OboxSteamUsers
RESEND_APITOKEN=
RESEND_FROM=noreply@example.com
APP_BASE_URL=http://localhost:3000
API_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (docker-compose service oboxsteam.database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=OboxSteam_db
POSTGRES_PORT=5433

# AWS
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_MEDIACONVERT_ENDPOINT=
AWS_MEDIACONVERT_ROLE_ARN=
AWS_SNS_TOPIC_ARN=
AWS_REKOGNITION_ROLE_ARN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS Bedrock Mantle
BEDROCK_API_KEY=
BEDROCK_MANTLE_REGION=ap-southeast-2

# JaaS (8x8) — LiveOnline embedded meetings
JaaS__AppId=vpaas-magic-cookie-your-app-id
JaaS__KeyId=vpaas-magic-cookie-your-app-id/your-key-id
JaaS__Domain=8x8.vc

# Local dev: inline PEM (escape newlines as \n). Do not set PrivateKeyPath locally.
JaaS__PrivateKey="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY_BODY\n-----END PRIVATE KEY-----"

